{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 350,
    "height": 247,
    "title": {
        "text": "Tourism Numbers Coming to Australia, 2019 vs 2024",
        "fontSize": 14
    },

    "data": {
        "url": "https://raw.githubusercontent.com/basto89326/FIT3179_Data_Visualisation_2/refs/heads/main/data/tourism_incoming.csv"
    },

    "layer": [
        {
            "mark": "bar",
            "selection": {
                "year_filter": {
                    "type": "multi",
                    "fields": ["Year"],
                    "bind": "legend"
                }
            },

            "transform": [
                {
                    "calculate": "datum.Year == 2019 ? -datum.Trips : datum.Trips",
                    "as": "signed_trips"
                }
            ],

            "encoding": {
                "x": {
                    "aggregate": "sum",
                    "field": "signed_trips",
                    "type": "quantitative",
                    "title": "Trips (Thousands)",
                    "axis": {"format": "d"}
                },

                "y": {
                    "field": "Country",
                    "type": "nominal"
                },

                "color": {
                    "field": "Year",
                    "type": "nominal",
                    "legend": {"title": "Year (click to filter)"},
                    "scale": {
                        "domain": ["2019", "2024"],
                        "range": ["#721f81", "#f1605d"]
                    }
                },

                "opacity": {
                    "condition": {"selection": "year_filter", "value": 1},
                    "value": 0.2
                },

                "tooltip": [
                    {"field": "Country", "type": "nominal"},
                    {"field": "Year", "type": "ordinal"},
                    {"field": "Trips", "type": "quantitative", "title": "Trips (thousands)"}
                ]
            }
        },

        {
            "mark": {
                "type": "text",
                "align": "left",
                "dx": -333,
                "dy": 15
            },

            "transform": [
                {"filter": {"field": "Country", "equal": "China"}},
                {"filter": {"field": "Year", "equal": "2019"}},

                {
                    "calculate": "'The number of trips from ;China was ' + datum['Trips'] + '; thousand in ' + datum['Year']",
                    "as": "text_annotation_raw"
                },

                {
                    "calculate": "split(datum.text_annotation_raw, ';')",
                    "as": "text_annotation"
                }
            ],

            "encoding": {

                "x": {
                    "aggregate": "sum",
                    "field": "Trips",
                    "type": "quantitative"
                },

                "y": {
                    "field": "Country",
                    "type": "nominal"
                },

                "text": {"field": "text_annotation"}
            }
        },

        {
            "mark": {
                "type": "text",
                "align": "left",
                "dx": -32,
                "dy": 15
            },

            "transform": [
                {"filter": {"field": "Country", "equal": "China"}},
                {"filter": {"field": "Year", "equal": "2024"}},

                {
                    "calculate": "'The number of trips from; China was ' + datum['Trips'] + '; thousand in ' + datum['Year']",
                    "as": "text_annotation_raw"
                },

                {
                    "calculate": "split(datum.text_annotation_raw, ';')",
                    "as": "text_annotation"
                }
            ],

            "encoding": {

                "x": {
                    "aggregate": "sum",
                    "field": "Trips",
                    "type": "quantitative"
                },

                "y": {
                    "field": "Country",
                    "type": "nominal"
                },

                "text": {"field": "text_annotation"}
            }
        }
    ],

    "config": {
        "axis": {
            "gridOpacity": 0.5
        }
    }
}
